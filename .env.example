# Use lowercase for the GitHub owner and repository name.
IMAGE=ghcr.io/your-name/stronghold-protocol-action:latest
BIND_ADDRESS=0.0.0.0
HTTP_PORT=3000
SP_COMBAT=client
SP_VERIFY=off
TRUST_PROXY=auto
SP_PLUGIN_SCRIPTS=sandbox
# auto：仅在镜像构建时启用了插件仓库的情况下开启管理器。
# latest 默认没有插件来源；设为 1 可仅使用游戏更新功能，0 直接运行镜像内的原版游戏。
PLUGIN_MANAGER_ENABLED=auto
# 以下两个变量控制宿主机端口映射，容器内管理端口固定为 3001。
# 127.0.0.1 仅供服务器本机访问；设为 0.0.0.0 后可通过服务器 IP 访问。
MANAGER_BIND_ADDRESS=127.0.0.1
MANAGER_PORT=3001
# 可选 HTTP Basic 密码：浏览器原生登录框，用户名固定为 admin；留空不要求登录。
# 含 $、# 等字符时可用单引号包裹，例如 PLUGIN_MANAGER_PASSWORD='自己的密码'。
# 远程访问建议使用 HTTPS。修改 .env 后运行 docker compose up -d，restart 不重新读取配置。
PLUGIN_MANAGER_PASSWORD=
# 无密码且使用域名时填写主机名，多个用逗号分隔、不加空格，不含协议/端口/路径。
# 例如 manager.example.com；这是 Host 检查配置，不是客户端 IP 白名单。
PLUGIN_MANAGER_ALLOWED_HOSTS=
# Default official Release API, or a compatible mirror/fork API.
GAME_RELEASE_API=https://api.github.com/repos/sganggs/Stronghold-Protocol/releases/latest
# Optional fixed update/lite ZIP URL; takes precedence over GAME_RELEASE_API.
GAME_UPDATE_URL=
GAME_UPDATE_SHA256=
# Optional token for GitHub API rate limits. Not passed to the game.
GITHUB_TOKEN=
