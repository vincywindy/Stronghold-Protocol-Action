{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stronghold Protocol Action plugin discovery catalog",
  "type": "object",
  "required": ["schemaVersion", "sources", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["repository", "ref", "revision"],
        "additionalProperties": false,
        "properties": {
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "ref": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "id", "name", "version", "license", "adapter", "path"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,31}$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "adapter": { "enum": ["native", "forge", "lele"] },
          "path": { "type": "string", "pattern": "^[^./\\\\:][^\\\\:]*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [{ "if": { "properties": { "adapter": { "const": "forge" } } }, "then": { "required": ["sha256"] } }]
      }
    }
  }
}
