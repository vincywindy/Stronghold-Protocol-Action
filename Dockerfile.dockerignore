# This file takes precedence over the upstream .dockerignore, even with an external context.
**
!package.json
!package-lock.json
!server/**
!shared/**
!data/**
!public/**
!packs/**
!tools/**
!schemas/**
!scripts/**
!plugins/**
!plugin-build.json
!plugin-build-reports/**
!plugin-sources/**
!test/helpers/battleHarness.js
!docs/research/**
!LICENSE
!NOTICE.md
!THIRD-PARTY-NOTICES.md
!.container-assets/**
# Generate vendor files; art comes from a verified Release or the branch downloader, never host state.
public/vendor
public/assets
public/fonts
# Prepared plugin builds carry their art snapshot and manifests separately from ordinary host files.
# Their raw packages and import diagnostics are retained even when a plugin cannot be loaded.
!.plugin-art/**
public/dev
data/local-assets.json
**/node_modules
**/.git
**/.env
**/.env.*
**/__pycache__
**/*.pyc
